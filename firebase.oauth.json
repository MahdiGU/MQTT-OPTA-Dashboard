{
  "hosting": {
    "site": "elmajd-automation",
    "public": "oauth-site",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.json"],
    "cleanUrls": true,
    "headers": [{"source":"**","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"}
    ]}]
  }
}
